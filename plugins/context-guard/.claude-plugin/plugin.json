{
  "name": "context-guard",
  "description": "Warns you before the context window fills up, while there is still room to save your work and start a clean session. Optional statusline badge and a /wrap-up command.",
  "version": "0.1.0",
  "author": {
    "name": "DijitalPi",
    "url": "https://dijitalpi.com"
  },
  "homepage": "https://github.com/DijitalPi/claude-plugins/tree/main/plugins/context-guard",
  "license": "MIT",
  "keywords": [
    "context",
    "context-window",
    "tokens",
    "compact",
    "productivity",
    "workflow"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
