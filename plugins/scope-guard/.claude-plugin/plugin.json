{
  "name": "scope-guard",
  "description": "Catches writes that land outside the project you are working in — the failure mode of having several repos open at once. Asks by default, blocks if you tell it to.",
  "version": "0.1.0",
  "author": {
    "name": "DijitalPi",
    "url": "https://dijitalpi.com"
  },
  "homepage": "https://github.com/DijitalPi/claude-plugins/tree/main/plugins/scope-guard",
  "license": "MIT",
  "keywords": [
    "safety",
    "workspace",
    "monorepo",
    "multi-project",
    "guardrails"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scope-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
